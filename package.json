{
  "name": "eduboard-ide",
  "version": "0.0.1",
  "private": true,
  "description": "Open-source K12 physical computing desktop IDE (early development)",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "build": "electron-vite build",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run test:desktop"
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "monaco-editor": "0.57.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.2",
    "electron-vite": "5.0.0",
    "playwright": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "license": "GPL-3.0-only",
  "overrides": {
    "dompurify": "3.4.17"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
