{
  "name": "eduboard-ide",
  "version": "0.3.0-alpha.1",
  "author": "EduBoard IDE contributors",
  "private": true,
  "description": "Desktop IDE for development boards with Blockly, Arduino C++ and MicroPython",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "build": "electron-vite build",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "test:arduino": "node scripts/smoke-arduino.mjs",
    "test:dev": "node scripts/smoke-dev.mjs",
    "test:blocks": "node scripts/smoke-blocks.mjs",
    "test:modes": "node scripts/smoke-modes.mjs",
    "test:examples": "node --import tsx scripts/compile-examples.mts",
    "examples:generate": "node --import tsx scripts/compile-examples.mts --write-examples",
    "test:python-examples": "node --import tsx scripts/check-python-examples.mts",
    "test:python": "node scripts/smoke-python.mjs",
    "test:serial-bridge": "node scripts/check-serial-bridge.mjs",
    "examples:python": "node --import tsx scripts/check-python-examples.mts --write-examples",
    "check": "npm run typecheck && npm test && npm run build && npm run test:desktop && npm run test:blocks && npm run test:modes && npm run test:python && npm run test:python-examples",
    "package:dir": "npm run build && electron-builder --dir --win --x64 --publish never",
    "package:win": "npm run check && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "blockly": "13.4.0",
    "monaco-editor": "0.57.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "playwright": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "license": "GPL-3.0-only",
  "overrides": {
    "dompurify": "3.4.17",
    "@electron/get": "5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
