  "source": "# Generated by EduBoard IDE. Runs on the MicroPython device.\nfrom machine import Pin, ADC\nimport time\nimport dht\n\neduDht_4 = dht.DHT11(Pin(4))\neduDhtTime_4 = None\n\ndef eduReadDht_4(humidity):\n    global eduDhtTime_4\n    now = time.ticks_ms()\n    if eduDhtTime_4 is None or time.ticks_diff(now, eduDhtTime_4) >= 2000:\n        try:\n            eduDht_4.measure()\n            eduDhtTime_4 = now\n        except OSError:\n            return float(\"nan\")\n    return eduDht_4.humidity() if humidity else eduDht_4.temperature()\n\n\n\nwhile True:\n  print('Temperature C:')\n  print(eduReadDht_4(False))\n  print('Humidity %:')\n  print(eduReadDht_4(True))\n  time.sleep_ms(2000)\n",
